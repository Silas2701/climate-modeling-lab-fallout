#! /bin/ksh

set -e

ENV_NAME="climate-modeling-lab"
PYTHON_VERSION="3.11"

# ksh-style arrays
set -A PACKAGES xarray netcdf4 numpy

# --- required args ---
START_YEAR=""
END_YEAR=""
INPUT_DATA_DIR=""

# --- optional args ---
OUTPUT_DATA_DIR=""
CONFIG_FILE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --start-year)
            START_YEAR="$2"
            shift 2
            ;;
        --end-year)
            END_YEAR="$2"
            shift 2
            ;;
        --input-data-dir)
            INPUT_DATA_DIR="$2"
            shift 2
            ;;
        --output-data-dir)
            OUTPUT_DATA_DIR="$2"
            shift 2
            ;;
        --config-file)
            CONFIG_FILE="$2"
            shift 2
            ;;
        --help)
            echo "Usage:"
            echo "  $0 --start-year <year> --end-year <year> --input-data-dir <dir> [--output-data-dir <dir>] [--config-file <file>]"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
    esac
done

# --- validation ---
if [ -z "$START_YEAR" ] || [ -z "$END_YEAR" ] || [ -z "$INPUT_DATA_DIR" ]; then
    echo "Missing required arguments."
    echo "Required: --start-year --end-year --input-data-dir"
    exit 1
fi

echo "Checking if environment '$ENV_NAME' exists..."

if conda env list | awk '{print $1}' | grep -qx "$ENV_NAME"; then
    echo "Environment exists. Removing..."

    conda remove -y -n "$ENV_NAME" --all
fi

echo "Creating environment..."
conda create -y -n "$ENV_NAME" python="$PYTHON_VERSION" "${PACKAGES[@]}"

echo "Done! Environment '$ENV_NAME' is ready."

echo "Execute script, modifying input data!"

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

# Build argument list
set -- python $PROJECT_ROOT/scripts/python/main.py \
    --start-year "$START_YEAR" \
    --end-year "$END_YEAR" \
    --input-data-dir "$INPUT_DATA_DIR"

if [ -n "$OUTPUT_DATA_DIR" ]; then
    set -- "$@" --output-data-dir "$OUTPUT_DATA_DIR"
fi

if [ -n "$CONFIG_FILE" ]; then
    set -- "$@" --config-file "$CONFIG_FILE"
fi

# Run with conda
conda run -n "$ENV_NAME" "$@"

conda remove -y -n "$ENV_NAME" --all
echo "Environment '$ENV_NAME' removed again!"